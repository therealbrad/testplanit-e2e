{
  "name": "testplanit-e2e",
  "version": "1.0.0",
  "description": "End-to-end test suite for testplanit.com using WebdriverIO",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:contact": "wdio run wdio.conf.js --spec test/specs/contact-form.spec.js",
    "test:landing": "wdio run wdio.conf.js --spec test/specs/landing-page.spec.js",
    "test:pricing": "wdio run wdio.conf.js --spec test/specs/pricing.spec.js"
  },
  "dependencies": {
    "@wdio/cli": "^8.39.0",
    "@wdio/globals": "^8.39.0",
    "@wdio/junit-reporter": "^8.36.1",
    "@wdio/local-runner": "^8.39.0",
    "@wdio/mocha-framework": "^8.36.1",
    "@wdio/spec-reporter": "^8.36.1",
    "chromedriver": "^147.0.4",
    "wdio-chromedriver-service": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
